# Copy to .env and adjust. Every value shown is the default used by compose.yaml.

# --- Infrastructure (also used for compose interpolation)
POSTGRES_USER=payments
POSTGRES_PASSWORD=payments
POSTGRES_DB=payments
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# --- API
API_KEY=dev-api-key

# --- Outbox relay
RELAY_BATCH_SIZE=100
RELAY_POLL_INTERVAL_SECONDS=0.5
OUTBOX_RETENTION_DAYS=7
OUTBOX_CLEANUP_INTERVAL_SECONDS=3600

# --- Consumer
CONSUMER_PREFETCH_COUNT=10
# Retries AFTER the first delivery: 3 => up to 4 attempts, waiting 1 s, 4 s, 16 s.
MAX_RETRIES=3
RETRY_BASE_DELAY_SECONDS=1
RETRY_BACKOFF_FACTOR=4
WEBHOOK_TIMEOUT_SECONDS=5

# --- Emulated payment gateway
PAYMENT_MIN_DELAY_SECONDS=2
PAYMENT_MAX_DELAY_SECONDS=5
PAYMENT_SUCCESS_RATE=0.9

# --- Demo webhook receiver: answer 500 on /hook to watch retries end in the DLQ
WEBHOOK_SINK_FAIL=false

LOG_LEVEL=INFO
